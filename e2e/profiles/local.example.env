E2E_RUN_LABEL=local-rehearsal
E2E_FE_URL=http://localhost:3000
E2E_API_URL=http://localhost:5004/api/v1
E2E_API_READY_PATH=/health/ready

E2E_EMAIL=observer@example.test
E2E_PASSWORD=replace-me

E2E_EVENT_SLUG=customer-observer-event
E2E_EVENT_TITLE=Customer Observer Event
E2E_INVENTORY_MODE=seated
E2E_SEAT_LABEL=A1
E2E_SEAT_SELECTION_MODE=exact

E2E_RECIPIENT_FULL_NAME=Demo Customer
E2E_RECIPIENT_EMAIL=observer@example.test
E2E_RECIPIENT_COUNTRY_CODE=+84
E2E_RECIPIENT_PHONE=901234567
E2E_RECIPIENT_ID_PASSPORT=

E2E_COMPLETION_MODE=reservation-only
E2E_PAYMENT_METHOD=

E2E_NAVIGATION_TIMEOUT_MS=30000
E2E_WAITROOM_TIMEOUT_MS=120000
E2E_PAYMENT_TIMEOUT_MS=60000
E2E_HEADLESS=false
E2E_SLOW_MO_MS=500
E2E_TICKET_DIALOG_REVIEW_MS=5000
E2E_TICKET_REVIEW_MS=5000
E2E_DIAGNOSTIC_TRACE=false

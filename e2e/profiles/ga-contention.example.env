# Copy to e2e/profiles/<name>.env. Real profiles are ignored by git.
# Values from allowlisted E2E_* process environment variables override this file.

# Human-readable label and target. FE and API must use the same environment.
E2E_RUN_LABEL=local-ga-contention
E2E_FE_URL=http://localhost:3000
E2E_API_URL=http://localhost:5004/api/v1
E2E_API_READY_PATH=/health/ready

# GA target. The event must be non-seated. Both customers select this exact
# ticket type and quantity. For a deterministic one-winner demo, prepare the
# durable available quantity to equal E2E_GA_QUANTITY before starting.
E2E_EVENT_SLUG=replace-with-ga-event
E2E_EVENT_TITLE=Replace With GA Event Title
E2E_INVENTORY_MODE=ga
E2E_TICKET_TYPE_NAME=GA Contention Demo
# Optional additional identity check; leave empty to resolve the ID by name.
E2E_TICKET_TYPE_ID=
E2E_GA_QUANTITY=2

# Two different non-privileged customers. Either can win, so both recipient
# blocks must be valid. Never commit real credentials in a non-example file.
E2E_CUSTOMER_A_LABEL=Customer A
E2E_CUSTOMER_A_EMAIL=customer-a@example.test
E2E_CUSTOMER_A_PASSWORD=replace-me
E2E_CUSTOMER_A_RECIPIENT_FULL_NAME=Demo Customer A
E2E_CUSTOMER_A_RECIPIENT_EMAIL=customer-a@example.test
E2E_CUSTOMER_A_RECIPIENT_COUNTRY_CODE=+84
E2E_CUSTOMER_A_RECIPIENT_PHONE=901234561
E2E_CUSTOMER_A_RECIPIENT_ID_PASSPORT=

E2E_CUSTOMER_B_LABEL=Customer B
E2E_CUSTOMER_B_EMAIL=customer-b@example.test
E2E_CUSTOMER_B_PASSWORD=replace-me
E2E_CUSTOMER_B_RECIPIENT_FULL_NAME=Demo Customer B
E2E_CUSTOMER_B_RECIPIENT_EMAIL=customer-b@example.test
E2E_CUSTOMER_B_RECIPIENT_COUNTRY_CODE=+84
E2E_CUSTOMER_B_RECIPIENT_PHONE=901234562
E2E_CUSTOMER_B_RECIPIENT_ID_PASSPORT=

# Only the resolved winner continues. Use reservation-only with an empty
# payment method for a fast 201/409 rehearsal, or the settings below for the
# same VNPay sandbox continuation used by the seated contention demo.
E2E_COMPLETION_MODE=vnpay-sandbox-success
E2E_PAYMENT_METHOD=vnpay
E2E_VNPAY_SANDBOX_ORIGIN=https://sandbox.vnpayment.vn
E2E_VNPAY_BANK_CODE=NCB
E2E_VNPAY_CARD_NUMBER=9704198526191432198
E2E_VNPAY_CARDHOLDER_NAME=NGUYEN VAN A
E2E_VNPAY_CARD_ISSUE_DATE=07/15
E2E_VNPAY_OTP=123456

# Milliseconds. Navigation/waitroom/payment cover the normal shared journey;
# gate/result control the synchronized race; max skew limits release distance.
E2E_NAVIGATION_TIMEOUT_MS=30000
E2E_WAITROOM_TIMEOUT_MS=300000
E2E_PAYMENT_TIMEOUT_MS=180000
E2E_CONTENTION_GATE_TIMEOUT_MS=30000
E2E_CONTENTION_RESULT_TIMEOUT_MS=30000
E2E_CONTENTION_MAX_RELEASE_SKEW_MS=2000

# Presentation pauses and automatic per-customer Playwright video recording.
E2E_CONTENTION_REVIEW_MS=10000
E2E_TICKET_DIALOG_REVIEW_MS=10000
E2E_TICKET_REVIEW_MS=10000
E2E_HEADLESS=false
E2E_SLOW_MO_MS=750
E2E_CONTENTION_TILE_WINDOWS=true
E2E_CONTENTION_WINDOW_WIDTH=960
E2E_CONTENTION_WINDOW_HEIGHT=900

# Local-only trace; it can contain sensitive browser/network context.
E2E_DIAGNOSTIC_TRACE=false

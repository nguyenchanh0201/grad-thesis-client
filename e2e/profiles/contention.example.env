# Copy to e2e/profiles/<name>.env. Real profiles are ignored by git.
# Values from E2E_* process environment variables override this file.

# Human-readable run label and the browser/API target. Keep FE/API on the same
# local or deployed environment so browser cookies and observed API traffic
# agree.
E2E_RUN_LABEL=local-seat-contention
E2E_FE_URL=http://localhost:3000
E2E_API_URL=http://localhost:5004/api/v1
E2E_API_READY_PATH=/health/ready

# Event identity and inventory contract. Contention requires one literal seat;
# AUTO and fallback selection are rejected because they hide the race.
E2E_EVENT_SLUG=replace-with-seated-event
E2E_EVENT_TITLE=Replace With Event Title
E2E_INVENTORY_MODE=seated
E2E_SEAT_LABEL=A-1

# Customer A credentials and recipient data. Use a dedicated non-privileged
# account; never commit a real password.
E2E_CUSTOMER_A_LABEL=Customer A
E2E_CUSTOMER_A_EMAIL=customer-a@example.test
E2E_CUSTOMER_A_PASSWORD=replace-me
E2E_CUSTOMER_A_RECIPIENT_FULL_NAME=Demo Customer A
E2E_CUSTOMER_A_RECIPIENT_EMAIL=customer-a@example.test
E2E_CUSTOMER_A_RECIPIENT_COUNTRY_CODE=+84
E2E_CUSTOMER_A_RECIPIENT_PHONE=901234561
E2E_CUSTOMER_A_RECIPIENT_ID_PASSPORT=

# Customer B must be a different dedicated account. Either customer may win,
# so both recipient blocks must be valid.
E2E_CUSTOMER_B_LABEL=Customer B
E2E_CUSTOMER_B_EMAIL=customer-b@example.test
E2E_CUSTOMER_B_PASSWORD=replace-me
E2E_CUSTOMER_B_RECIPIENT_FULL_NAME=Demo Customer B
E2E_CUSTOMER_B_RECIPIENT_EMAIL=customer-b@example.test
E2E_CUSTOMER_B_RECIPIENT_COUNTRY_CODE=+84
E2E_CUSTOMER_B_RECIPIENT_PHONE=901234562
E2E_CUSTOMER_B_RECIPIENT_ID_PASSPORT=

# Winner continuation. The default demo completes the winner through the
# official VNPay sandbox; the loser remains on the real seat conflict result.
# Use reservation-only for a reservation/409 rehearsal without payment.
E2E_COMPLETION_MODE=vnpay-sandbox-success
E2E_PAYMENT_METHOD=vnpay

# VNPay sandbox-only values. Use the provider's documented test card/OTP or
# local placeholders; never put merchant or production credentials here.
E2E_VNPAY_SANDBOX_ORIGIN=https://sandbox.vnpayment.vn
E2E_VNPAY_BANK_CODE=NCB
E2E_VNPAY_CARD_NUMBER=9704198526191432198
E2E_VNPAY_CARDHOLDER_NAME=NGUYEN VAN A
E2E_VNPAY_CARD_ISSUE_DATE=07/15
E2E_VNPAY_OTP=123456

# All timeout/review values are milliseconds. Navigation covers slow dev SSR;
# waitroom and payment cover queue/hosted checkout; gate waits for both clients
# to be ready; result waits for both reservation responses; max release skew is
# the allowed difference between the two released attempts.
E2E_NAVIGATION_TIMEOUT_MS=30000
E2E_WAITROOM_TIMEOUT_MS=300000
E2E_PAYMENT_TIMEOUT_MS=180000
E2E_CONTENTION_GATE_TIMEOUT_MS=30000
E2E_CONTENTION_RESULT_TIMEOUT_MS=30000
E2E_CONTENTION_MAX_RELEASE_SKEW_MS=2000

# Review pauses keep payment/ticket screens visible before the browser closes.
E2E_CONTENTION_REVIEW_MS=10000
E2E_TICKET_DIALOG_REVIEW_MS=10000
E2E_TICKET_REVIEW_MS=10000

# Browser mode and presentation. HEADLESS=false shows both customers; SLOW_MO
# delays actions; tile/window values control optional side-by-side placement.
E2E_HEADLESS=false
E2E_SLOW_MO_MS=750
E2E_CONTENTION_TILE_WINDOWS=true
E2E_CONTENTION_WINDOW_WIDTH=960
E2E_CONTENTION_WINDOW_HEIGHT=900

# Diagnostic trace is opt-in and can contain sensitive network context.
E2E_DIAGNOSTIC_TRACE=false
